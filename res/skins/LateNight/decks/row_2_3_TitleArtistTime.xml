<Template>
  <WidgetGroup>
    <Layout>horizontal</Layout>
    <SizePolicy>me,min</SizePolicy>
    <Children>

      <WidgetGroup>
        <ObjectName>DeckRow_2_3_ArtistTitleTime</ObjectName>
        <Layout>vertical</Layout>
        <SizePolicy>i,min</SizePolicy>
        <Children>

          <WidgetGroup>
            <ObjectName>TitleRow</ObjectName>
            <Layout>horizontal</Layout>
            <SizePolicy>i,min</SizePolicy>
            <Children>
              <WidgetGroup>
                <Layout>horizontal</Layout>
                <SizePolicy>i,min</SizePolicy>
                <Children>
                  <TrackProperty>
                    <ObjectName>TitleText</ObjectName>
                    <Size>0me,25f</Size>
                    <TooltipId>track_title</TooltipId>
                    <Property>titleInfo</Property>
                    <Alignment>Left</Alignment>
                    <Elide>right</Elide>
                    <Channel><Variable name="ChanNum"/></Channel>
                    <Connection>
                      <ConfigKey><Variable name="Group"/>,track_loaded</ConfigKey>
                      <BindProperty>highlight</BindProperty>
                    </Connection>
                  </TrackProperty>
                </Children>
              </WidgetGroup>

              <WidgetGroup>
                <ObjectName>AlignRight</ObjectName>
                <Layout>horizontal</Layout>
                <SizePolicy>p,min</SizePolicy>
                <MinimumSize>80,</MinimumSize>
                <Children>
                  <NumberPos>
                    <ObjectName>PlayPositionText</ObjectName>
                    <TooltipId>track_time</TooltipId>
                    <Size>0min,25f</Size>
                    <Alignment>right</Alignment>
                    <Channel><Variable name="ChanNum"/></Channel>
                    <Connection>
                      <ConfigKey><Variable name="Group"/>,playposition</ConfigKey>
                    </Connection>
                  </NumberPos>
                </Children>
                <Connection>
                  <ConfigKey><Variable name="Group"/>,track_loaded</ConfigKey>
                  <BindProperty>visible</BindProperty>
                </Connection>
              </WidgetGroup>
            </Children>
          </WidgetGroup><!-- TitleRow -->

          <WidgetGroup>
            <ObjectName>TrackColorFullCompact</ObjectName>
            <Layout>horizontal</Layout>
            <Size>0me,2f</Size>
            <Children>
              <TrackWidgetGroup>
                <Size>0me,2f</Size>
                <Group><Variable name="Group"/></Group>
                <TrackColorAlpha>255</TrackColorAlpha>
              </TrackWidgetGroup>
            </Children>
          </WidgetGroup>

          <WidgetGroup>
            <ObjectName>ArtistRow</ObjectName>
            <Layout>horizontal</Layout>
            <SizePolicy>me,min</SizePolicy>
            <Children>
              <WidgetGroup>
                <Layout>horizontal</Layout>
                <SizePolicy>me,min</SizePolicy>
                <Children>
                  <TrackProperty>
                    <ObjectName>ArtistText</ObjectName>
                    <Size>0me,25f</Size>
                    <TooltipId>track_artist</TooltipId>
                    <Property>artist</Property>
                    <Elide>right</Elide>
                    <Channel><Variable name="ChanNum"/></Channel>
                    <Connection>
                      <ConfigKey><Variable name="Group"/>,track_loaded</ConfigKey>
                      <BindProperty>highlight</BindProperty>
                    </Connection>
                  </TrackProperty>
                </Children>
              </WidgetGroup>
              <WidgetGroup><!-- Beat counter: 4 beat LEDs + beats to next phrase -->
                <ObjectName>BeatCounter</ObjectName>
                <Layout>horizontal</Layout>
                <SizePolicy>max,min</SizePolicy>
                <Children>
                  <Template src="skins:LateNight/decks/beat_counter_led.xml">
                    <SetVariable name="Beat">1</SetVariable>
                    <SetVariable name="LedName">BeatLedDownbeat</SetVariable>
                  </Template>
                  <Template src="skins:LateNight/decks/beat_counter_led.xml">
                    <SetVariable name="Beat">2</SetVariable>
                    <SetVariable name="LedName">BeatLed</SetVariable>
                  </Template>
                  <Template src="skins:LateNight/decks/beat_counter_led.xml">
                    <SetVariable name="Beat">3</SetVariable>
                    <SetVariable name="LedName">BeatLed</SetVariable>
                  </Template>
                  <Template src="skins:LateNight/decks/beat_counter_led.xml">
                    <SetVariable name="Beat">4</SetVariable>
                    <SetVariable name="LedName">BeatLed</SetVariable>
                  </Template>
                  <Number>
                    <ObjectName>BarInPhraseText</ObjectName>
                    <TooltipId>bar_in_phrase</TooltipId>
                    <Size>44f,25f</Size>
                    <Alignment>center</Alignment>
                    <Text>BAR %1</Text>
                    <NumberOfDigits>0</NumberOfDigits>
                    <Connection>
                      <ConfigKey><Variable name="Group"/>,bar_in_phrase</ConfigKey>
                    </Connection>
                  </Number>
                  <Number>
                    <ObjectName>PhraseCountdownText</ObjectName>
                    <TooltipId>beats_until_phrase</TooltipId>
                    <Size>32f,25f</Size>
                    <Alignment>center</Alignment>
                    <Text>-%1</Text>
                    <NumberOfDigits>0</NumberOfDigits>
                    <Connection>
                      <ConfigKey><Variable name="Group"/>,beats_until_phrase</ConfigKey>
                    </Connection>
                    <Connection>
                      <ConfigKey><Variable name="Group"/>,phrase_last_bar</ConfigKey>
                      <BindProperty>highlight</BindProperty>
                    </Connection>
                  </Number>
                </Children>
                <Connection>
                  <!-- hidden while no track with beatgrid is loaded (value 0) -->
                  <ConfigKey><Variable name="Group"/>,beat_in_bar</ConfigKey>
                  <BindProperty>visible</BindProperty>
                </Connection>
              </WidgetGroup>
              <WidgetGroup>
                <ObjectName>AlignRight</ObjectName>
                <Layout>horizontal</Layout>
                <SizePolicy>max,min</SizePolicy>
                <Children>
                  <TrackProperty>
                    <ObjectName>DurationText</ObjectName>
                    <TooltipId>track_duration</TooltipId>
                    <Size>0min,25f</Size>
                    <Alignment>right</Alignment>
                    <Property>durationTextSeconds</Property>
                    <Channel>
                      <Variable name="ChanNum"/>
                    </Channel>
                  </TrackProperty>
                </Children>
              </WidgetGroup>

            </Children>
          </WidgetGroup><!-- ArtistRow -->

        </Children>
        <Connection>
          <ConfigKey persist="true">[Skin],show_rate_controls</ConfigKey>
          <BindProperty>highlight</BindProperty>
        </Connection>
      </WidgetGroup><!-- DeckRow_2_3_ArtistTitleTime -->
    </Children>
  </WidgetGroup>
</Template>
